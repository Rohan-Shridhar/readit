{
    "manifest_version": 3,
    "name": "readit",
    "version": "0.4.0",
    "description": "Improve reading experience by word-by-word highlighting on webpages",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "64": "icons/icon64.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_popup": "popup/popup.html",
        "default_title": "readit",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "64": "icons/icon64.png",
            "128": "icons/icon128.png"
        }
    },
    "permissions": [
        "activeTab",
        "storage"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://*/*",
                "http://*/*"
            ],
            "js": [
                "content/reading-engine.js",
                "content/content.js"
            ],
            "css": [
                "content/content.css"
            ]
        }
    ],
    "background": {
        "service_worker": "background/background.js"
    }
}
